{
  "name": "@retrobat/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply retrobat-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply retrobat-db --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "0.4.1",
    "@retrobat/shared": "workspace:*",
    "drizzle-orm": "0.36.4",
    "hono": "4.6.14",
    "jose": "5.9.6",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20241127.0",
    "drizzle-kit": "0.28.1",
    "typescript": "5.7.2",
    "wrangler": "3.91.0"
  }
}
