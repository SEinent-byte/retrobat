<Window x:Class="RetroBat.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:brand="clr-namespace:RetroBat.Core.Branding;assembly=RetroBat.Core"
        Title="{x:Static brand:BrandInfo.Name}" Height="320" Width="460"
        WindowStartupLocation="CenterScreen"
        Background="#121212" Loaded="OnLoaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static brand:BrandInfo.FullName}"
                   Foreground="White" FontSize="28" FontWeight="Bold" />
        <TextBlock Grid.Row="1" Text="{Binding UserEmail}"
                   Foreground="#9E9E9E" FontSize="13" Margin="0,2,0,0" />

        <Border Grid.Row="2" Margin="0,16,0,10" Padding="14"
                Background="#1E1E1E" CornerRadius="8">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                       Foreground="White" FontSize="15" />
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding SyncInfo}" TextWrapping="Wrap"
                   Foreground="#7FBF7F" FontSize="12" VerticalAlignment="Top" />

        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Sign in with Google" Margin="8,0,0,0" Padding="14,8"
                    Command="{Binding SignInCommand}" />
            <Button Content="Start 7-day trial" Margin="8,0,0,0" Padding="14,8"
                    Command="{Binding StartTrialCommand}"
                    Visibility="{Binding CanStartTrial, Converter={StaticResource BoolToVis}}" />
            <Button Content="Sign out" Margin="8,0,0,0" Padding="14,8"
                    Command="{Binding SignOutCommand}"
                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</Window>
