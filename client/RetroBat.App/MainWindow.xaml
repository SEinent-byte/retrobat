<Window x:Class="RetroBat.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RetroBat" Height="560" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#121212" Loaded="OnLoaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="RetroBat"
                   Foreground="White" FontSize="28" FontWeight="Bold" />
        <TextBlock Grid.Row="1" Text="{Binding UserEmail}"
                   Foreground="#9E9E9E" FontSize="13" Margin="0,2,0,0" />

        <Border Grid.Row="2" Margin="0,16,0,12" Padding="14"
                Background="#1E1E1E" CornerRadius="8">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                       Foreground="White" FontSize="15" />
        </Border>

        <ListBox Grid.Row="3" ItemsSource="{Binding Games}"
                 SelectedItem="{Binding SelectedGame}"
                 Background="#1A1A1A" Foreground="White" BorderThickness="0"
                 Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Text="{Binding Title}" Foreground="White"
                                   FontSize="14" Width="300" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SystemName}" Foreground="#9E9E9E"
                                   FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ProgressBar Grid.Row="4" Height="6" Margin="0,10,0,10"
                     Minimum="0" Maximum="1" Value="{Binding DownloadProgress}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Sign in with Google" Margin="8,0,0,0" Padding="14,8"
                    Command="{Binding SignInCommand}" />
            <Button Content="Start 7-day trial" Margin="8,0,0,0" Padding="14,8"
                    Command="{Binding StartTrialCommand}"
                    Visibility="{Binding CanStartTrial, Converter={StaticResource BoolToVis}}" />
            <Button Content="Play" Margin="8,0,0,0" Padding="14,8"
                    Command="{Binding PlayCommand}"
                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" />
            <Button Content="Refresh" Margin="8,0,0,0" Padding="14,8"
                    Command="{Binding RefreshCommand}"
                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" />
            <Button Content="Sign out" Margin="8,0,0,0" Padding="14,8"
                    Command="{Binding SignOutCommand}"
                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</Window>
