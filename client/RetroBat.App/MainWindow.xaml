<Window x:Class="RetroBat.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RetroBat" Height="360" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="#121212" Loaded="OnLoaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="RetroBat"
                   Foreground="White" FontSize="28" FontWeight="Bold" />
        <TextBlock Grid.Row="1" Text="{Binding UserEmail}"
                   Foreground="#9E9E9E" FontSize="13" Margin="0,2,0,0" />

        <Border Grid.Row="2" Margin="0,20" Padding="16"
                Background="#1E1E1E" CornerRadius="8" VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                       Foreground="White" FontSize="16" />
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Sign in with Google" Margin="8,0,0,0" Padding="14,8"
                    Command="{Binding SignInCommand}" />
            <Button Content="Start 7-day trial" Margin="8,0,0,0" Padding="14,8"
                    Command="{Binding StartTrialCommand}"
                    Visibility="{Binding CanStartTrial, Converter={StaticResource BoolToVis}}" />
            <Button Content="Refresh" Margin="8,0,0,0" Padding="14,8"
                    Command="{Binding RefreshCommand}"
                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" />
            <Button Content="Sign out" Margin="8,0,0,0" Padding="14,8"
                    Command="{Binding SignOutCommand}"
                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</Window>
