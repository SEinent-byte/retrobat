<Window x:Class="RetroBat.Launcher.AccountMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mi Cuenta" Width="460"
        SizeToContent="Height" MinHeight="300"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="NoResize" Background="#121212" Topmost="True">
    <Border BorderBrush="#2c2c2c" BorderThickness="1">
        <StackPanel Margin="28">
            <TextBlock Text="Mi Cuenta"
                       Foreground="White" FontSize="22" FontWeight="Bold" />
            <TextBlock x:Name="StatusText" Text="Cargando…"
                       Foreground="#C8C8C8" FontSize="14" TextWrapping="Wrap"
                       Margin="0,10,0,18" MinHeight="40" />

            <Button x:Name="SignInButton" Content="Iniciar sesión con Google"
                    Height="40" Margin="0,0,0,10" Click="OnSignIn" />
            <Button x:Name="TrialButton" Content="Activar prueba gratis (7 días)"
                    Height="40" Margin="0,0,0,10" Click="OnStartTrial" />
            <Button x:Name="SignOutButton" Content="Cerrar sesión"
                    Height="40" Margin="0,0,0,10" Click="OnSignOut" />
            <Button x:Name="BackButton" Content="Volver" Height="40" Click="OnClose" />
        </StackPanel>
    </Border>
</Window>
