<Window x:Class="RetroBat.Launcher.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:brand="clr-namespace:RetroBat.Core.Branding;assembly=RetroBat.Core"
        Title="{x:Static brand:BrandInfo.Name}" Height="180" Width="460"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="NoResize" Background="#121212" Topmost="True">
    <Border BorderBrush="#2c2c2c" BorderThickness="1">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/toro.png" Width="32" Height="32" Margin="0,0,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="TitleText" Text="{x:Static brand:BrandInfo.FullName}"
                           VerticalAlignment="Center"
                           Foreground="White" FontSize="22" FontWeight="Bold" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Grid.Row="1" Text="Preparing…"
                       Foreground="#C8C8C8" FontSize="14" Margin="0,10,0,12" />
            <ProgressBar x:Name="Bar" Grid.Row="2" Height="8"
                         Minimum="0" Maximum="1" IsIndeterminate="True" />
        </Grid>
    </Border>
</Window>
